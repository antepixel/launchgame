{
  "name": "swing-gallery",
  "tree": {
    "$className": "DataModel",
    "ServerScriptService": {
      "SwingBuilder": {
        "$path": "src/ServerScriptService/SwingBuilder.luau"
      },
      "SwingGallery": {
        "$path": "gallery/SwingGallery.server.luau"
      }
    },
    "ReplicatedStorage": {
      "Config": {
        "$className": "Folder",
        "LaunchConfig": {
          "$path": "src/ReplicatedStorage/Config/LaunchConfig.luau"
        },
        "SwingTierVisuals": {
          "$path": "src/ReplicatedStorage/Config/SwingTierVisuals.luau"
        },
        "SwingGeometry": {
          "$path": "src/ReplicatedStorage/Config/SwingGeometry.luau"
        }
      }
    },
    "Workspace": {
      "$properties": {
        "StreamingEnabled": false
      },
      "Baseplate": {
        "$className": "Part",
        "$properties": {
          "Anchored": true,
          "Position": [200, -2, 0],
          "Size": [500, 4, 120],
          "Material": "Grass",
          "Color": [0.29, 0.56, 0.2]
        }
      }
    }
  }
}
