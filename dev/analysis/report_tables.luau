-- Renders the markdown tables in REPORT.md straight out of dev/out/*.json, so
-- no number in the report is retyped by hand.
--
--   lune run dev/analysis/report_tables.luau > dev/out/tables.md
--
-- Run from the REPO ROOT, after roll_ev.luau and slot_sim.luau.
local fs = require("@lune/fs")
local serde = require("@lune/serde")

local ev = serde.decode("json", fs.readFile("dev/out/roll_ev.json"))
local econ = serde.decode("json", fs.readFile("dev/out/roll_economics.json"))

local TIER_NAMES = { "Common", "Uncommon", "Rare", "Epic", "Legendary", "Mythic", "Secret", "Divine" }

local function money(n: number): string
	if n == nil then
		return "n/a"
	end
	local sign = if n < 0 then "-" else ""
	local a = math.abs(n)
	local function f(v, suffix)
		return string.format("%s$%.3g%s", sign, v, suffix)
	end
	if a >= 1e15 then return f(a / 1e15, "Qa")
	elseif a >= 1e12 then return f(a / 1e12, "T")
	elseif a >= 1e9 then return f(a / 1e9, "B")
	elseif a >= 1e6 then return f(a / 1e6, "M")
	elseif a >= 1e3 then return f(a / 1e3, "K")
	end
	return f(a, "")
end

local function pct(x: number): string
	if x == nil then return "n/a" end
	if x == 0 then return "-" end
	if x < 0.0001 then return string.format("%.2e%%", x * 100) end
	return string.format("%.4f%%", x * 100)
end

local function num(x: number?, fmt: string): string
	if x == nil then return "n/a" end
	return string.format(fmt, x)
end

print("<!-- generated by dev/analysis/report_tables.luau -->")

--=============================== 0g: the slimes ===============================--
print("\n### T0g. All 65 slimes\n")
print("| id | name | tier | base income/s |")
print("|---|---|---|---|")
for _, s in ev.slimes do
	print(string.format("| %d | %s | %d %s | $%s |", s.id, s.name, s.tier, TIER_NAMES[s.tier], tostring(s.baseIncomePerSecond)))
end

--============================ 0f: tier -> luck ============================--
print("\n### T0f. Swing tier to luck (perfect launch)\n")
print("| tier | visual scale | distance scale | launch distance | landing Z | distance from band 0 | band | zone | pre-box luck | reward source | price |")
print("|---|---|---|---|---|---|---|---|---|---|---|")
for _, t in econ.tiers do
	print(string.format("| %d | %.2f | %.4f | %.2f | %.2f | %.2f | %d | %s | %s | %s | %s |",
		t.swingTier, t.visualScale, t.distanceScale, t.launchDistanceStuds, t.landingZ, t.distanceFromBandZero,
		t.bandIndex, t.zone, tostring(t.luckValue), t.rewardSource, money(t.price)))
end

--=========================== Step 1: per-roll value ===========================--
print("\n### T1. Expected value of one roll, per swing tier\n")
print("| tier | pre-box luck | source | E[base income]/roll (exact) | E[base income]/roll (2M sampled) | P(Divine) | P(Secret+) | max sampled-vs-exact PMF deviation |")
print("|---|---|---|---|---|---|---|---|")
for _, e in ev.tiers do
	print(string.format("| %d | %s | %s | %s | %s | %s | %s | %.2e |",
		e.swingTier, tostring(e.bandLuck), e.rewardSource,
		money(e.analyticExpectedIncome), money(e.sampledExpectedIncome),
		pct(e.pDivine), pct(e.pSecretOrBetter), e.worstPmfDeviation))
end

print("\n### T1b. Tier histogram of one roll (exact, box chain integrated)\n")
local header = "| tier | pre-box luck |"
local divider = "|---|---|"
for _, name in TIER_NAMES do
	header ..= " " .. name .. " |"
	divider ..= "---|"
end
print(header)
print(divider)
for _, e in ev.tiers do
	local row = string.format("| %d | %s |", e.swingTier, tostring(e.bandLuck))
	for tier = 1, 8 do
		row ..= " " .. pct(e.tierHistogram[tier]) .. " |"
	end
	print(row)
end

print("\n### T1c. Full probability mass over the 65 slimes, per swing tier\n")
local h = "| id | slime | base/s |"
local d = "|---|---|---|"
for tier = 1, 11 do
	h ..= string.format(" T%d |", tier)
	d ..= "---|"
end
print(h)
print(d)
for _, s in ev.slimes do
	local row = string.format("| %d | %s | $%s |", s.id, s.name, tostring(s.baseIncomePerSecond))
	for tier = 1, 11 do
		row ..= " " .. pct(ev.tiers[tier].analyticPmf[s.id]) .. " |"
	end
	print(row)
end

--========================= Step 2: the slot policy =========================--
print("\n### T2. Held-set base income/s under the best-10 policy\n")
print("| tier | 100 rolls (median) | 1,000 rolls (median) | 10,000 rolls (median) | p10 @10k | p90 @10k | ceiling | rolls to 50% | to 90% | to 99% |")
print("|---|---|---|---|---|---|---|---|---|---|")
for _, t in econ.tiers do
	print(string.format("| %d | %s | %s | %s | %s | %s | %s | %s | %s | %s |",
		t.swingTier,
		money(t.incomeByHorizon["100"].median), money(t.incomeByHorizon["1000"].median),
		money(t.equilibriumIncomePerSecond), money(t.equilibriumP10), money(t.equilibriumP90),
		money(t.asymptoteIncomePerSecond),
		tostring(t.rollsTo50Percent), tostring(t.rollsTo90Percent), tostring(t.rollsTo99Percent)))
end

print("\n### T2b. Marginal value of the Nth roll (mean gain per roll over the window [N, 2N))\n")
print("| tier | N=10 | N=50 | N=100 | N=500 | N=1000 | N=5000 | first N with rate < 1% of 10k-roll income | first N with rate < 1% of income held at N |")
print("|---|---|---|---|---|---|---|---|---|")
for _, t in econ.tiers do
	local m = t.marginalWindow
	print(string.format("| %d | %s | %s | %s | %s | %s | %s | %s | %s |",
		t.swingTier, money(m.n10), money(m.n50), money(m.n100), money(m.n500), money(m.n1000), money(m.n5000),
		tostring(t.marginalBelowOnePercentAtRoll), tostring(t.marginalBelowOnePercentOfCurrentAtRoll)))
end

--=========================== Step 3: the drain ===========================--
print("\n### T3. Level-reset drain (re-max every displaced slot immediately)\n")
print("| tier | cycle floor (s/roll) | re-max spend over first 1,000 rolls | re-max $/roll @10k | drain $/s | gross $/s (all maxed) | drain as % of gross | realised $/s |")
print("|---|---|---|---|---|---|---|---|")
for _, t in econ.tiers do
	print(string.format("| %d | %.2f | %s | %s | %s | %s | %s | %s |",
		t.swingTier, t.cycleSecondsFloor, money(t.remaxSpendFirst1000Rolls), money(t.remaxSpendPerRollAtEquilibrium),
		money(t.remaxDrainDollarsPerSecond), money(t.grossIncomePerSecondMaxed),
		string.format("%.1f%%", t.remaxDrainFraction * 100), money(t.realisedIncomePerSecond)))
end

print("\n### T3b. The same drain at the shorter roll budgets\n")
print("| tier | @100: gross | @100: drain % | @100: realised | @1000: gross | @1000: drain % | @1000: realised |")
print("|---|---|---|---|---|---|---|")
for _, t in econ.tiers do
	local a, b = t.incomeByHorizon["100"], t.incomeByHorizon["1000"]
	print(string.format("| %d | %s | %s | %s | %s | %s | %s |",
		t.swingTier, money(a.grossMaxedIncomePerSecond), string.format("%.1f%%", a.remaxDrainFraction * 100), money(a.realisedIncomePerSecond),
		money(b.grossMaxedIncomePerSecond), string.format("%.1f%%", b.remaxDrainFraction * 100), money(b.realisedIncomePerSecond)))
end

--========================= Step 4: the exchange rate =========================--
for _, horizon in { "100", "1000", "10000" } do
	print(string.format("\n### T4-%s. Price against the $600-per-income/s exchange rate (roll budget %s)\n", horizon, horizon))
	print("| tier | price | delta realised income/s | implied price at $600/(income/s) | ratio | payback (s) | payback (h) | prev tier levelling capacity | price / capacity |")
	print("|---|---|---|---|---|---|---|---|---|")
	for tier = 2, 11 do
		local t = econ.tiers[tier]
		local x = t.exchangeByHorizon[horizon]
		print(string.format("| %d | %s | %s | %s | %s | %s | %s | %s | %s |",
			tier, money(t.price), money(x.deltaRealisedIncomePerSecond), money(x.impliedPriceAtExchangeRate),
			num(x.priceToImpliedRatio, "%.4g"), num(x.paybackSeconds, "%.4g"),
			x.paybackSeconds and string.format("%.4g", x.paybackSeconds / 3600) or "n/a",
			money(x.previousTierLevellingCapacityCost), num(x.priceOverPreviousCapacity, "%.3g")))
	end
end

--===================== Step 5: model against measurement =====================--
print("\n### T5. The assumed geometric ramp against measurement\n")
print("| tier | ramp multiplier | model income/s | measured realised/s @100 | @1,000 | @10,000 | measured/model @100 | @1,000 | @10,000 |")
print("|---|---|---|---|---|---|---|---|---|")
for _, t in econ.tiers do
	print(string.format("| %d | %.3fx | %s | %s | %s | %s | %.3g | %.3g | %.3g |",
		t.swingTier, t.modelRampMultiplier, money(t.modelIncomePerSecond),
		money(t.incomeByHorizon["100"].realisedIncomePerSecond),
		money(t.incomeByHorizon["1000"].realisedIncomePerSecond),
		money(t.incomeByHorizon["10000"].realisedIncomePerSecond),
		t.measuredOverModelByHorizon["100"], t.measuredOverModelByHorizon["1000"], t.measuredOverModelByHorizon["10000"]))
end
