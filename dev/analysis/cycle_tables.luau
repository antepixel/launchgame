-- Renders the markdown tables in REPORT.md from dev/out/cycle_economics.json,
-- so no number in the report is retyped by hand.
--
--   lune run dev/analysis/cycle_tables.luau > dev/out/cycle_tables.md
--
-- Run from the REPO ROOT, after cycle_time.luau.
local fs = require("@lune/fs")
local serde = require("@lune/serde")

local d = serde.decode("json", fs.readFile("dev/out/cycle_economics.json"))
local MODELS = { "perfect", "hit50", "hit20" }
local MODEL_LABEL = { perfect = "perfect play (hits the first pass)", hit50 = "50% hit rate per pass", hit20 = "20% hit rate per pass" }

local function money(n: number?): string
	if n == nil then return "n/a" end
	local sign = if n < 0 then "-" else ""
	local a = math.abs(n)
	local function f(v, s) return string.format("%s$%.3g%s", sign, v, s) end
	if a >= 1e12 then return f(a / 1e12, "T")
	elseif a >= 1e9 then return f(a / 1e9, "B")
	elseif a >= 1e6 then return f(a / 1e6, "M")
	elseif a >= 1e3 then return f(a / 1e3, "K") end
	return f(a, "")
end
local function g(x: number?, fmt: string): string
	if x == nil then return "n/a" end
	return string.format(fmt, x)
end

print("<!-- generated by dev/analysis/cycle_tables.luau -->")

--================================== STEP 2 ==================================--
print("\n### C2. The multiplier bar, per tier\n")
print("Sweep period is `SWING_PERIOD_SECONDS` = " .. tostring(d.constants.swingPeriodSeconds) ..
	"s at every tier. Sweet-spot window = `SWEET_SPOT_WIDTH` (" .. tostring(d.constants.sweetSpotWidthPhase) ..
	" of a period) = " .. string.format("%.4f", d.constants.sweetSpotWidthSeconds) .. "s, also identical at every tier.\n")
print("| tier | snap threshold | perfect (snapped) window | window landing the same band as a perfect launch | best consolation band | its window | chest window |")
print("|---|---|---|---|---|---|---|")
for _, t in d.tiers do
	print(string.format("| %d | %.2f | %.4f s | %.4f s | band %d | %.4f s | %s |",
		t.swingTier, t.snapThreshold, t.snapWindowSeconds, t.sameOutcomeWindowSeconds,
		t.consolationRingBand, t.consolationRingSeconds,
		if t.chestWindowSeconds > 0 then string.format("%.4f s", t.chestWindowSeconds) else "-"))
end

print("\n### C2b. Expected bar time per successful launch\n")
print("| player model | expected bar wait per launch |")
print("|---|---|")
for _, m in MODELS do
	print(string.format("| %s | %.2f s |", MODEL_LABEL[m], d.tiers[1].byPlayerModel[m].barWaitSeconds))
end

--================================== STEP 3 ==================================--
print("\n### C3. Flight, per tier (perfect launch)\n")
print("| tier | distance (studs) | arch height (studs) | launch angle | flight duration |")
print("|---|---|---|---|---|")
for _, t in d.tiers do
	print(string.format("| %d | %.1f | %.2f | %.2f deg%s | %.4f s |",
		t.swingTier, t.flight.distance, t.flight.archHeight, t.flight.launchAngleDegrees,
		if t.flight.launchAngleClamped then " (clamped)" else "", t.flight.durationSeconds))
end

--================================== STEP 5 ==================================--
print("\n### C5. Landing and return, per tier\n")
print("| tier | landing Z | return mechanism | walk on foot | walk time | remount walk | remount time |")
print("|---|---|---|---|---|---|---|")
for _, t in d.tiers do
	local walkStuds = if t.rewardPhases.walkToChestStuds then t.rewardPhases.walkToChestStuds else 0
	local walkSeconds = if t.rewardPhases.walkToChestSeconds then t.rewardPhases.walkToChestSeconds else 0
	print(string.format("| %d | %.2f | %s | %.2f studs | %.3f s | %.2f studs | %.3f s |",
		t.swingTier, t.flight.landingZ,
		if t.rewardSource == "chest" then "walk to chest, then teleport" else "teleport (no travel)",
		walkStuds, walkSeconds, t.remountWalkStuds, t.remountSeconds))
end

--================================== STEP 6 ==================================--
for _, m in MODELS do
	print(string.format("\n### C6-%s. Cycle time -- %s\n", m, MODEL_LABEL[m]))
	print("| tier | bar wait | flight | reward scene | return | total cycle | launches/min | dominant phase |")
	print("|---|---|---|---|---|---|---|---|")
	for _, t in d.tiers do
		local c = t.byPlayerModel[m]
		print(string.format("| %d | %.2f s | %.2f s | %.2f s | %.2f s | **%.2f s** | %.2f | %s |",
			t.swingTier, c.barWaitSeconds, c.flightSeconds, c.rewardSceneSeconds, c.returnSeconds,
			c.totalCycleSeconds, c.launchesPerMinute, c.dominantPhase))
	end
end

--================================== STEP 7 ==================================--
for _, m in MODELS do
	print(string.format("\n### C7-%s. Closed loop -- %s\n", m, MODEL_LABEL[m]))
	print("| tier | price | realised income/s | launches/min | rolls to 90% | real minutes to 90% | delta income/s | implied price | ratio | payback (h) |")
	print("|---|---|---|---|---|---|---|---|---|---|")
	for _, t in d.tiers do
		local j = t.joined[m]
		print(string.format("| %d | %s | %s | %.2f | %d | %.1f | %s | %s | %s | %s |",
			t.swingTier, money(t.price), money(j.realisedIncomePerSecond), j.launchesPerMinute,
			t.rollsTo90Percent, j.minutesTo90PercentEquilibrium,
			money(j.deltaRealisedIncomePerSecond), money(j.impliedPriceAtExchangeRate),
			g(j.priceToImpliedRatio, "%.4g"),
			if j.paybackSeconds then string.format("%.4g", j.paybackSeconds / 3600) else "n/a"))
	end
end

print("\n### C7b. Exhaustion against affordability (perfect play)\n")
print("| tier | minutes until exhausted | minutes to afford next (equilibrium income, as specified) | minutes to afford next (never levelled) | minutes to afford next (fully maxed) | dead time, unlevelled | dead time, maxed |")
print("|---|---|---|---|---|---|---|")
for _, t in d.tiers do
	local j = t.joined.perfect
	print(string.format("| %d | %.1f | %s | %s | %s | %s | %s |",
		t.swingTier, j.minutesToExhaustionRelative,
		g(j.minutesToAffordNextTier, "%.3g"),
		g(j.minutesToAffordNextTierUnlevelled, "%.4g"),
		g(j.minutesToAffordNextTierMaxed, "%.4g"),
		g(j.deadTimeMinutesUnlevelled, "%+.4g"),
		g(j.deadTimeMinutesMaxed, "%+.4g")))
end

print("\n### C7c. Measured progression against the ladder's design targets\n")
print("Target = the wait for the tier named in the row, per `ShopConfig.luau:39-43`. Measured = time spent at the previous tier banking that price, integrated along the held-set growth curve.\n")
print("| tier reached | target | perfect, unlevelled | ratio | perfect, maxed | ratio | 50% hit, unlevelled | ratio | 20% hit, unlevelled | ratio |")
print("|---|---|---|---|---|---|---|---|---|---|")
for tier = 2, 11 do
	local prev = d.tiers[tier - 1]
	local target = d.designTargetSeconds[tostring(tier)]
	local p, h50, h20 = prev.joined.perfect, prev.joined.hit50, prev.joined.hit20
	print(string.format("| %d | %.4g min | %s min | %s | %s min | %s | %s min | %s | %s min | %s |",
		tier, target / 60,
		g(p.minutesToAffordNextTierUnlevelled, "%.4g"), g(p.measuredOverTargetUnlevelled, "%.3g"),
		g(p.minutesToAffordNextTierMaxed, "%.4g"), g(p.measuredOverTargetMaxed, "%.3g"),
		g(h50.minutesToAffordNextTierUnlevelled, "%.4g"), g(h50.measuredOverTargetUnlevelled, "%.3g"),
		g(h20.minutesToAffordNextTierUnlevelled, "%.4g"), g(h20.measuredOverTargetUnlevelled, "%.3g")))
end
