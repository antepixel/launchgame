-- Renders the markdown tables in REPORT.md from dev/out/slot_sweep.json, so no
-- number in the report is retyped by hand.
--
--   lune run dev/analysis/sweep_tables.luau > dev/out/sweep_tables.md
--
-- Run from the REPO ROOT, after slot_sweep.luau.
local fs = require("@lune/fs")
local serde = require("@lune/serde")

local d = serde.decode("json", fs.readFile("dev/out/slot_sweep.json"))
local HEADLINE = { 10, 15, 20, 30, 50 }
local TIERS = 11
local sw = {}
for _, e in d.sweep do
	sw[e.slots .. ":" .. e.tier] = e
end

local function money(n: number?): string
	if n == nil then return "n/a" end
	local sign = if n < 0 then "-" else ""
	local a = math.abs(n)
	local function f(v, s) return string.format("%s$%.3g%s", sign, v, s) end
	if a >= 1e12 then return f(a / 1e12, "T")
	elseif a >= 1e9 then return f(a / 1e9, "B")
	elseif a >= 1e6 then return f(a / 1e6, "M")
	elseif a >= 1e3 then return f(a / 1e3, "K") end
	return f(a, "")
end
local function g(x: number?, fmt: string): string
	if x == nil then return "n/a" end
	return string.format(fmt, x)
end
local function header(cols: { string })
	print("| " .. table.concat(cols, " | ") .. " |")
	local dashes = {}
	for _ = 1, #cols do table.insert(dashes, "---") end
	print("|" .. table.concat(dashes, "|") .. "|")
end

print("<!-- generated by dev/analysis/sweep_tables.luau -->")

--=============================== STEP 1 ===============================--
print("\n### K1a. Rolls to exhaustion, by slot count and tier\n")
header({ "tier", "K=10", "K=15", "K=20", "K=30", "K=50", "change 10 -> 50" })
for tier = 1, TIERS do
	local row = { tostring(tier) }
	for _, k in HEADLINE do
		table.insert(row, tostring(sw[k .. ":" .. tier].rollsToExhaustion))
	end
	local a, b = sw["10:" .. tier].rollsToExhaustion, sw["50:" .. tier].rollsToExhaustion
	table.insert(row, string.format("%+d rolls (%.2fx)", b - a, b / a))
	print("| " .. table.concat(row, " | ") .. " |")
end

print("\n### K1b. The sweep in full (median held-set base income/s)\n")
print("Ceiling = K x $350,000, the top Divine slime in every slot -- duplicates are permitted (step 0a). `rolls to X%` are percentages **of that ceiling**, not of any horizon value.\n")
header({ "K", "tier", "ceiling", "p50 @100", "p50 @1k", "p50 @10k", "p50 @20k", "rolls to 50%", "to 90%", "to 99%", "exhaustion (rolls)", "levelling capacity @10k" })
for _, k in HEADLINE do
	for tier = 1, TIERS do
		local e = sw[k .. ":" .. tier]
		print(string.format("| %d | %d | %s | %s | %s | %s | %s | %s | %s | %s | %s | %s |",
			k, tier, money(e.ceiling),
			money(e.income["100"].p50), money(e.income["1000"].p50),
			money(e.income["10000"].p50), money(e.income["20000"].p50),
			tostring(e.rollsToCeiling50), tostring(e.rollsToCeiling90), tostring(e.rollsToCeiling99),
			tostring(e.rollsToExhaustion), money(e.levellingCapacityAt10000)))
	end
end

--=============================== STEP 2 ===============================--
print("\n### K2. Percentile spread of held-set base income/s\n")
header({ "K", "tier", "p10 @100", "p50 @100", "p90 @100", "p90/p10", "p10 @1k", "p50 @1k", "p90 @1k", "p90/p10", "p10 @10k", "p50 @10k", "p90 @10k", "p90/p10" })
for _, k in HEADLINE do
	for tier = 1, TIERS do
		local e = sw[k .. ":" .. tier]
		local cells = { tostring(k), tostring(tier) }
		for _, key in { "100", "1000", "10000" } do
			local b = e.income[key]
			table.insert(cells, money(b.p10))
			table.insert(cells, money(b.p50))
			table.insert(cells, money(b.p90))
			table.insert(cells, g(b.p90OverP10, "%.2f"))
		end
		print("| " .. table.concat(cells, " | ") .. " |")
	end
end

print("\n### K2b. Where outcome variance has effectively vanished (p90/p10 < 1.5)\n")
header({ "roll budget", "K=10", "K=15", "K=20", "K=30", "K=50" })
for _, key in { "100", "1000", "10000" } do
	local row = { key .. " rolls" }
	for _, k in HEADLINE do
		local tiers = {}
		for tier = 1, TIERS do
			local r = sw[k .. ":" .. tier].income[key].p90OverP10
			if r and r < 1.5 then
				table.insert(tiers, tostring(tier))
			end
		end
		table.insert(row, if #tiers == 0 then "none" else "tiers " .. table.concat(tiers, ", "))
	end
	print("| " .. table.concat(row, " | ") .. " |")
end

--=============================== STEP 3 ===============================--
for _, model in { "perfect", "hit50", "hit20" } do
	print(string.format("\n### K3-%s. Real time -- %s\n", model, model))
	header({ "tier", "K=10 exhaust", "K=15", "K=20", "K=30", "K=50", "K=10 to 90% ceiling", "K=15", "K=20", "K=30", "K=50" })
	for tier = 1, TIERS do
		local row = { tostring(tier) }
		for _, k in HEADLINE do
			table.insert(row, g(sw[k .. ":" .. tier].minutesToExhaustion[model], "%.1f min"))
		end
		for _, k in HEADLINE do
			table.insert(row, g(sw[k .. ":" .. tier].minutesToCeiling90[model], "%.0f min"))
		end
		print("| " .. table.concat(row, " | ") .. " |")
	end
end

--=============================== STEP 4 ===============================--
print("\n### K4. Dead time by slot count (perfect play)\n")
print("Positive = dead time (tier exhausted, still grinding). Negative = skipped content.\n")
header({ "K", "tier", "exhaustion (min)", "afford next: unlevelled", "dead: unlevelled", "afford next: maxed", "dead: maxed" })
for _, k in HEADLINE do
	for tier = 1, 10 do
		local e = sw[k .. ":" .. tier]
		local a = e.affordability.perfect
		print(string.format("| %d | %d | %.1f | %s | %s | %s | %s |",
			k, tier, e.minutesToExhaustion.perfect,
			g(a.minutesUnlevelled, "%.1f"), g(a.deadMinutesUnlevelled, "%+.1f"),
			g(a.minutesMaxed, "%.1f"), g(a.deadMinutesMaxed, "%+.1f")))
	end
end

print("\n### K4b. Totals over tiers 1-10, perfect play\n")
header({ "K", "content (h)", "dead: unlevelled (h)", "content : dead", "dead: maxed (h)", "content : dead (maxed)" })
for _, k in HEADLINE do
	local t = d.deadTime.totals[tostring(k)]
	print(string.format("| %d | %.2f | %.1f | 1 : %.0f | %.1f | 1 : %.1f |",
		k, t.contentHours, t.deadHoursUnlevelled, t.deadHoursUnlevelled / t.contentHours,
		t.deadHoursMaxed, t.deadHoursMaxed / t.contentHours))
end

print("\n### K4c. Tiers 8-10 alone (the 107 hours), perfect play\n")
header({ "K", "content (min)", "dead: unlevelled (h)", "dead: maxed (h)" })
for _, k in HEADLINE do
	local content, deadA, deadB = 0, 0, 0
	for tier = 8, 10 do
		local e = sw[k .. ":" .. tier]
		content += e.minutesToExhaustion.perfect
		deadA += e.affordability.perfect.deadMinutesUnlevelled
		deadB += e.affordability.perfect.deadMinutesMaxed
	end
	print(string.format("| %d | %.1f | %.1f | %.1f |", k, content, deadA / 60, deadB / 60))
end

--=============================== STEP 5 ===============================--
print("\n### K5. The K at which dead time reaches zero\n")
print("Interpolated on log K between swept points; **extrapolated** where the curve does not cross inside K <= 50, using the slope of the last swept segment (30 -> 50).\n")
header({ "tier", "unlevelled: required K", "extrapolated?", "dead @K=10 (min)", "dead @K=50 (min)", "maxed: required K", "extrapolated?", "dead @K=10", "dead @K=50" })
for tier = 1, 10 do
	local u, m
	for _, r in d.requiredSlots do
		if r.tier == tier and r.bracket == "unlevelled" then u = r end
		if r.tier == tier and r.bracket == "maxed" then m = r end
	end
	print(string.format("| %d | %s | %s | %+.1f | %+.1f | %s | %s | %+.1f | %+.1f |",
		tier,
		u.requiredK and (if u.requiredK > 1e6 then string.format("%.2g", u.requiredK) else string.format("%.0f", u.requiredK)) or "n/a",
		if u.extrapolated then "yes" else "no", u.deadAtK10, u.deadAtK50,
		m.requiredK and (if m.requiredK > 1e6 then string.format("%.2g", m.requiredK) else string.format("%.0f", m.requiredK)) or "n/a",
		if m.extrapolated then "yes" else "no", m.deadAtK10, m.deadAtK50))
end

--=============================== STEP 6 ===============================--
print("\n### K6. Marginal value of one more slot, and its break-even price\n")
print("Break-even price = delta realised income/s x $600. Realised = maxed gross (28.6252x median base) less the measured re-max drain at that (K, tier), at perfect-play cadence. **Mean** columns are the stable estimator; the median difference between K and K+1 is quantised onto the distribution's own value grid and can read as zero or as noise of either sign.\n")
header({ "K -> K+1", "tier", "delta realised @1k (mean)", "break-even @1k", "delta realised @10k (mean)", "break-even @10k", "median-based @10k", "levelling capacity at K" })
for _, k in HEADLINE do
	for tier = 1, TIERS do
		local p
		for _, row in d.slotPricing.marginal do
			if row.fromSlots == k and row.tier == tier then p = row end
		end
		print(string.format("| %d -> %d | %d | %s | %s | %s | %s | %s | %s |",
			p.fromSlots, p.toSlots, tier,
			money(p.deltaRealisedIncomeMean1000), money(p.breakEvenPriceMean1000),
			money(p.deltaRealisedIncomeMean10000), money(p.breakEvenPriceMean10000),
			money(p.breakEvenPrice10000), money(p.levellingCapacityAt10000)))
	end
end

print("\n### K6b. Candidate price ladder for slots 11-30 (mean-based, 10,000-roll budget)\n")
print("**Tier assignment is an assumption**: two slots per swing tier from tier 3 upward, which is roughly the rate the measured progression moves through tiers. The full (K, tier) matrix is in K6 and in the JSON, so any other assignment can be read off it.\n")
header({ "slot", "assumed tier", "measured at K", "break-even price", "that tier's swing price, for scale" })
for _, row in d.slotPricing.candidateLadder do
	print(string.format("| %d | %d | %d | %s | %s |",
		row.slot, row.assumedTier, row.measuredAtSlots, money(row.breakEvenPrice), money(row.swingTierPriceForComparison)))
end

--=============================== STEP 7 ===============================--
print("\n### K7. The mutation arm -- MODELLED, no such system exists in the source\n")
print("At roll time, independently of the slime rolled, with probability p the slime is worth m times its base income. 2,000 sims per cell, seed 20260813. Every figure in this table is a model output, not a measurement of the game.\n")
header({ "K", "tier", "p", "m", "E[multiplier]", "ceiling", "exhaustion (rolls)", "exhaustion (min, perfect)", "p50 income @10k" })
for _, e in d.mutationArm.grid do
	print(string.format("| %d | %d | %.2f | %d | %.2fx%s | %s | %s | %s | %s |",
		e.slots, e.tier, e.mutationChance, e.mutationMultiplier, e.averageIncomeMultiplier,
		if e.averageIncomeMultiplier > 2 then " **>2x**" else "",
		money(e.ceiling), tostring(e.rollsToExhaustion),
		g(e.minutesToExhaustionPerfect, "%.1f"), money(e.p50IncomeAt10000)))
end
